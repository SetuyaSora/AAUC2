{
  "manifest_version": 3,
  "name": "AAUC2",
  "version": "2.4.0",
  "description": "Active Academy Advance のトップページを、見やすい時間割ダッシュボードに置き換えます。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*.ac.jp/aa_web/portal/*"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.ac.jp/aa_web/portal/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aauc2@setuyasora.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
